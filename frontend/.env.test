# Loaded by Vite (and therefore Vitest, which runs in mode "test") so that
# `import.meta.env.VITE_API_BASE_URL` is defined in the jsdom environment.
# client.ts reads it at module load and would throw on undefined, so this is not
# optional decoration -- it is what makes the API client importable in a test.
# The value only has to match what the msw handlers intercept; nothing listens
# on this port during a test run.
VITE_API_BASE_URL=http://localhost:8000/api
